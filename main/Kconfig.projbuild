menu "esp32-http-server Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            SSID of the access point to connect to.

    config WIFI_PASSWORD
        string "WiFi password"
        default "mypassword"
        help
            WPA2 password of the access point.

    config WIFI_MAX_RETRY
        int "Maximum connection retries"
        default 5
        help
            Number of reconnection attempts before giving up.

endmenu